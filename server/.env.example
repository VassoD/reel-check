# Required
OPENAI_API_KEY=            # research model calls (breakdown + web search per claim)
GLADIA_API_KEY=            # speech-to-text for the Reel's audio
APP_TOKEN=                 # shared secret the Android app sends as a bearer token; generate with: openssl rand -hex 24

# Optional (defaults shown)
# PORT=8787
# HOST=0.0.0.0                       # 0.0.0.0 so your phone can reach it over Wi-Fi
# RESEARCH_MODEL=gpt-6.1-sol         # default when the app hasn't picked one (astra, sol, terra or luna)
# REPORT_LANGUAGE=English            # language the analysis is written in
# DATA_DIR=./data                    # where the SQLite history lives
# YTDLP_COOKIES_FROM_BROWSER=chrome  # set if Instagram starts asking for a login
# MAX_CLAIMS_TO_INVESTIGATE=5        # each researched claim costs roughly $0.10-0.15
# MAX_ANALYSES_PER_HOUR=20           # spending guard
# MAX_CONCURRENT_ANALYSES=2
